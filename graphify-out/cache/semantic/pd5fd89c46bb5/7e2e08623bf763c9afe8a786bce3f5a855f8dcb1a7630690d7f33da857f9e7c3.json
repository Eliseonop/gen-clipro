{"nodes": [{"id": "docs_editor_editor_de_video", "label": "Editor de v\u00eddeo web (clips verticales)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existe para crear clips cortos y verticales (Shorts/Reels/TikTok) a partir de YouTube, archivos locales y stock; todo se organiza por proyectos para que material y composici\u00f3n viajen juntos."}, {"id": "docs_editor_proyecto", "label": "Proyecto (unidad de trabajo)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada proyecto guarda su material (v\u00eddeos, audios, im\u00e1genes, SFX) y su composici\u00f3n, de modo que el estado es autocontenido y reabrible desde la pantalla de inicio."}, {"id": "docs_editor_timeline", "label": "Timeline con pistas de v\u00eddeo/audio/texto", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_pistas", "label": "Pistas (crear, renombrar, ocultar, silenciar, bloquear, relacionar)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se permite relacionar una pista de audio con su pista de texto para que subt\u00edtulos y voz se muevan como una unidad."}, {"id": "docs_editor_main_editor", "label": "Main Editor (lienzo de composici\u00f3n)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_clip_editor", "label": "Clip Editor (preparar un tramo)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separa la preparaci\u00f3n del material (reencuadre, seguimiento de cara sobre un tramo) del montaje final, para que un clip pueda hornearse una vez y reutilizarse."}, {"id": "docs_editor_proxy_ligero", "label": "Proxy ligero del fragmento", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Al editar un tramo se genera un proxy ligero en lugar de cargar el v\u00eddeo original, para que el lienzo responda en tiempo real."}, {"id": "docs_editor_vista_previa_wysiwyg", "label": "Vista previa en vivo (lo que ves es lo que se exporta)", "file_type": "rationale", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invariante de dise\u00f1o declarado: la vista previa debe coincidir con el render exportado, lo que obliga a que preview y export compartan la misma sem\u00e1ntica de encuadre y animaci\u00f3n."}, {"id": "docs_editor_reencuadre", "label": "Reencuadre 16:9 \u2192 vertical", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorte con posici\u00f3n y zoom cuyo recuadro respeta siempre el formato de salida elegido, para pasar horizontal a vertical sin perder al sujeto."}, {"id": "docs_editor_seguimiento_de_cara", "label": "Seguimiento de cara autom\u00e1tico (suave / directo)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dos modos porque el seguimiento literal resulta brusco: 'suave' amortigua el movimiento del encuadre, 'directo' sigue la posici\u00f3n de la cara al pie de la letra."}, {"id": "docs_editor_keyframes", "label": "Keyframes (encuadre, posici\u00f3n, escala, rotaci\u00f3n, opacidad, volumen)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El seguimiento de cara se materializa como keyframes numerados y editables (a\u00f1adir en el cabezal, borrar, elegir tipo de transici\u00f3n), de modo que el resultado autom\u00e1tico siga siendo corregible a mano."}, {"id": "docs_editor_overlay_pip", "label": "Modo superponer (overlay / PIP)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El encuadre de la fuente y el tama\u00f1o en pantalla son independientes: el clip se coloca encima con su propia posici\u00f3n, escala y rotaci\u00f3n en lugar de rellenar todo el cuadro."}, {"id": "docs_editor_guardar_clip", "label": "Guardar clip (hornear reencuadre y animaci\u00f3n)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El resultado se 'hornea' en un clip reutilizable del material (con t\u00edtulo y descripci\u00f3n) y sobrescribe el original si se estaba editando uno existente."}, {"id": "docs_editor_heatmap_youtube", "label": "Tramos recomendados por heatmap de YouTube", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un tramo recomendado llega ya con un reencuadre inicial propuesto, para arrancar la edici\u00f3n desde algo utilizable en vez de desde cero."}, {"id": "docs_editor_material_stock", "label": "Material de stock (Pexels, GIPHY, Pixabay, Unsplash)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_panel_material", "label": "Columna izquierda \u2014 pesta\u00f1as de material y paneles", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los materiales y ajustes se organizan en pesta\u00f1as (Video, Imagen, Audio, SFX, Efectos, Figuras, Texto, Transiciones, Configuraci\u00f3n, Chat IA) en lugar de paneles simult\u00e1neos."}, {"id": "docs_editor_columna_resultado", "label": "Columna derecha \u2014 Resultado y formato de salida", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_formato_de_salida", "label": "Formato de salida (9:16, 16:9, 1:1, 4:5, 4:3, personalizado)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_transcripcion_whisper", "label": "Transcripci\u00f3n con Whisper (Tiny \u2192 Large v3)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El modelo es configurable para intercambiar velocidad por precisi\u00f3n; sobre un v\u00eddeo genera transcripci\u00f3n y sobre un audio genera subt\u00edtulos ya sincronizados."}, {"id": "docs_editor_subtitulos", "label": "Subt\u00edtulos y clips de texto", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_karaoke", "label": "Efecto karaoke (resaltado palabra a palabra)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_estilo_global_texto", "label": "Aplicar estilo de texto global / nivel pista", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dos \u00e1mbitos de propagaci\u00f3n: 'Global' copia estilo y posici\u00f3n a todos los textos del timeline, 'Nivel pista' fija el estilo de la pista y lo hereda tambi\u00e9n en los textos nuevos."}, {"id": "docs_editor_tts_narrador", "label": "Narraci\u00f3n TTS (Kokoro, Gemini, ElevenLabs)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los motores sin instalar o sin clave aparecen deshabilitados en vez de fallar al usarlos; Kokoro es local y permite mezclar dos voces con proporci\u00f3n regulable."}, {"id": "docs_editor_extraer_audio_youtube", "label": "Extraer audio de YouTube", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_biblioteca_sfx", "label": "Biblioteca de SFX (categor\u00edas y favoritos)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_efectos_visuales", "label": "Efectos visuales y ajustes de color", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_efectos_audio", "label": "Efectos de audio (volumen, fundidos, eq, compresor, reverb, echo)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_transiciones", "label": "Transiciones de entrada/salida (fade, dissolve, wipe, zoom, slide, pop)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_figuras", "label": "Figuras (formas, flechas, elementos UI)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_velocidad_clip", "label": "Velocidad del clip y reproducci\u00f3n inversa", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_exportar", "label": "Exportar proyecto a v\u00eddeo", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_json_proyecto", "label": "JSON del proyecto (ver/editar)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_editor_chat_ia", "label": "Chat IA (asistente que edita el proyecto)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El asistente ejecuta las mismas acciones del editor por lenguaje natural, con deshacer/rehacer y puntos de control, para que un error del modelo sea siempre reversible."}, {"id": "docs_editor_flujo_basico", "label": "Flujo b\u00e1sico de trabajo (7 pasos)", "file_type": "concept", "source_file": "docs/EDITOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_editor_editor_de_video", "target": "docs_editor_proyecto", "relation": "references", "confidence": "EXTRACTED", "confiden